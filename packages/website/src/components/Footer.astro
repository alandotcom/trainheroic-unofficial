---
import { pageHref, sitePath } from "../lib/paths.ts";

const path = sitePath(Astro.url.pathname);
---

<footer class="site-footer shell narrow">
  <p>Unofficial project. TrainHeroic is a separate company.</p>
  <div class="site-footer__links">
    <a href={pageHref("/support", path)}>Support</a>
    <a href={pageHref("/privacy", path)}>Privacy</a>
    <a href={pageHref("/terms", path)}>Terms</a>
    <a href="https://github.com/alandotcom/trainheroic-unofficial" aria-label="GitHub (opens in new tab)" target="_blank" rel="noopener noreferrer">GitHub</a>
    <a href="https://www.npmjs.com/org/trainheroic-unofficial" aria-label="npm (opens in new tab)" target="_blank" rel="noopener noreferrer">npm</a>
    <a href="https://mcp.trainheroic-unofficial.com/mcp">Hosted MCP</a>
  </div>
</footer>
