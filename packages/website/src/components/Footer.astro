---
import { MCP_URL, NPM_ORG_URL, REPO_URL } from "../data/site.ts";
import { pageHref, sitePath } from "../lib/paths.ts";

const path = sitePath(Astro.url.pathname);
---

<footer class="site-footer shell narrow">
  <p>Unofficial project. TrainHeroic is a separate company.</p>
  <div class="site-footer__links">
    <a href={pageHref("/support", path)}>Support</a>
    <a href={pageHref("/privacy", path)}>Privacy</a>
    <a href={pageHref("/terms", path)}>Terms</a>
    <a href={REPO_URL} aria-label="GitHub (opens in new tab)" target="_blank" rel="noopener noreferrer">GitHub</a>
    <a href={NPM_ORG_URL} aria-label="npm (opens in new tab)" target="_blank" rel="noopener noreferrer">npm</a>
    <a href={MCP_URL}>Hosted MCP</a>
  </div>
</footer>
