---
import { pageHref, sitePath, withBase } from "../lib/paths.ts";

interface Props {
  title: string;
  description: string;
  path?: string;
  image?: string;
  imageAlt?: string;
  directionContract?: boolean;
}

const SITE_NAME = "trainheroic-unofficial";
const SITE_URL = new URL("https://trainheroic-unofficial.com");
const DEFAULT_OG_IMAGE = "og-image.png";
const DEFAULT_OG_IMAGE_ALT =
  "trainheroic unofficial — TrainHeroic beyond the app, across AI, CLI, SDK, and export";

const {
  title,
  description,
  path = sitePath(Astro.url.pathname),
  image = DEFAULT_OG_IMAGE,
  imageAlt = DEFAULT_OG_IMAGE_ALT,
  directionContract = false,
} = Astro.props;

const pageTitle = `${title} · ${SITE_NAME}`;
const site = Astro.site ?? SITE_URL;
const canonical = new URL(path === "/" ? "" : path.slice(1), site);
const ogImage = new URL(withBase(image), site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, viewport-fit=cover"
    />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f3f1e9" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={pageHref("favicon.svg", Astro.url.pathname)} />
    <link
      rel="apple-touch-icon"
      href={pageHref("apple-touch-icon.png", Astro.url.pathname)}
    />
    <title>{pageTitle}</title>

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />
    <meta property="og:locale" content="en_US" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={imageAlt} />
  </head>
  <body>
    {
      directionContract && (
        <Fragment
          set:html={`<!--
      THESIS: One TrainHeroic toolkit through AI, terminal, SDK, and export; refuse a client-specific hero and a card-grid directory.
      OWN-WORLD: Warm paper, near-black ink, one cobalt lane, graphite program rules, square controls, compressed grotesk display, and mono only for code.
      STORY: Understand the shared toolkit, see one training-history task across four surfaces, then connect hosted MCP or choose a goal.
      FIRST VIEWPORT: A thin custom nav above a five/seven desktop split; on mobile, the thesis leads directly into goal navigation before the technical proof.
      FORM: The Shared Training Log, grounded direction 6; Parallel Lanes composition A; seed b0dc30a8.
      FINISH: unreviewed and undocumented is unfinished; this build ends with the finish review, the verdict, and DESIGN.md
    -->`}
        />
      )
    }
    <a class="skip-link" href="#main">Skip to main content</a>
    <slot />
  </body>
</html>

<style is:global>
  @import "../styles/global.css";
</style>
