---
import { pageHref, sitePath, withBase } from "../lib/paths.ts";
import data from "blume:data";
import Analytics from "blume/components/layout/Analytics.astro";
import ConsentHead from "blume/components/layout/ConsentHead.astro";
import ConsentBanner from "blume/components/layout/ConsentBanner.astro";

interface Props {
  title: string;
  description: string;
  path?: string;
  image?: string;
  imageAlt?: string;
  directionContract?: boolean;
}

const SITE_NAME = "trainheroic-unofficial";
const SITE_URL = new URL("https://trainheroic-unofficial.com");
const DEFAULT_OG_IMAGE = "og-image.png";
const DEFAULT_OG_IMAGE_ALT =
  "trainheroic unofficial — TrainHeroic beyond the app, across AI, CLI, SDK, and export";

const {
  title,
  description,
  path = sitePath(Astro.url.pathname),
  image = DEFAULT_OG_IMAGE,
  imageAlt = DEFAULT_OG_IMAGE_ALT,
  directionContract = false,
} = Astro.props;

const pageTitle = `${title} · ${SITE_NAME}`;
const site = Astro.site ?? SITE_URL;
function absolutePageUrl(pagePath: string): URL {
  const url = new URL(withBase(pagePath), site);
  url.pathname = url.pathname.replace(/\/+$/, "") || "/";
  return url;
}

const canonical = absolutePageUrl(path);
const ogImage = new URL(withBase(image), site);
const structuredData = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "@id": canonical.href,
  url: canonical.href,
  name: pageTitle,
  description,
  inLanguage: "en",
  isPartOf: {
    "@type": "WebSite",
    name: SITE_NAME,
    url: absolutePageUrl("/").href,
  },
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, viewport-fit=cover"
    />
    <meta name="description" content={description} />
    {data.config.consent && <ConsentHead consent={data.config.consent} />}
    {path !== "/export" && <Analytics analytics={data.config.analytics} />}
    <meta name="theme-color" content="#f3f1e9" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#141412" media="(prefers-color-scheme: dark)" />
    {/* Blume's docs pages pick the theme from the "blume-theme" key in localStorage, falling
        back to the OS setting. The custom pages run the same rule before first paint, so a
        reader moving between docs and custom pages keeps one theme and never sees a flash. */}
    <script is:inline>
      (() => {
        let stored = null;
        try {
          stored = localStorage.getItem("blume-theme");
        } catch {}
        const system = matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
        document.documentElement.dataset.theme = stored ?? system;
      })();
    </script>
    <link rel="canonical" href={canonical} />
    <link rel="describedby" type="text/plain" href={pageHref("/llms.txt", Astro.url.pathname)} />
    <link rel="describedby" type="application/json" href={pageHref("/agent-readability.json", Astro.url.pathname)} />
    <link rel="ai-catalog" type="application/ai-catalog+json" href={pageHref("/.well-known/ai-catalog.json", Astro.url.pathname)} />
    <link rel="icon" type="image/svg+xml" href={pageHref("favicon.svg", Astro.url.pathname)} />
    <link
      rel="apple-touch-icon"
      href={pageHref("apple-touch-icon.png", Astro.url.pathname)}
    />
    <title>{pageTitle}</title>

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />
    <meta property="og:locale" content="en_US" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={imageAlt} />
    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify(structuredData).replace(/</g, "\\u003c")}
    />
  </head>
  <body>
    {
      directionContract && (
        <Fragment
          set:html={`<!--
      THESIS: One TrainHeroic toolkit through AI, terminal, SDK, and export; refuse a client-specific hero and a card-grid directory.
      OWN-WORLD: Warm paper, near-black ink, one cobalt lane, graphite program rules, square controls, compressed grotesk display, and mono only for code.
      STORY: Understand the shared toolkit, see one training-history task across four surfaces, then connect hosted MCP or choose a goal.
      FIRST VIEWPORT: A thin custom nav above a five/seven desktop split; on mobile, the thesis leads directly into goal navigation before the technical proof.
      FORM: The Shared Training Log, grounded direction 6; Parallel Lanes composition A; seed b0dc30a8.
      FINISH: unreviewed and undocumented is unfinished; this build ends with the finish review, the verdict, and DESIGN.md
    -->`}
        />
      )
    }
    <a class="skip-link" href="#main">Skip to main content</a>
    <slot />
    <ConsentBanner policy="/privacy" />
  </body>
</html>

<style is:global>
  @import "../styles/global.css";

  [data-blume-consent-banner] {
    position: fixed;
    inset: auto 1rem 1rem auto;
    z-index: 100;
    width: min(24rem, calc(100% - 2rem));
    padding: 1rem;
    color: var(--color-ink);
    background: var(--color-bg);
    border: 1px solid var(--color-line);
    box-shadow: 0 4px 24px rgb(0 0 0 / 15%);
  }
  [data-blume-consent-banner] p { margin: 0; font-size: .875rem; }
  [data-blume-consent-banner] > div { display: flex; gap: .75rem; margin-top: .75rem; }
  [data-blume-consent-choice] {
    flex: 1;
    padding: .5rem 1rem;
    border: 1px solid var(--color-line);
    color: inherit;
    background: transparent;
    cursor: pointer;
  }
</style>
