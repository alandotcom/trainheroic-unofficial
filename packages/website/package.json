{
  "name": "@trainheroic-unofficial/website",
  "version": "0.0.18",
  "private": true,
  "type": "module",
  "description": "Marketing and documentation site for the TrainHeroic unofficial MCP and SDK.",
  "scripts": {
    "gen:mcp-tools": "tsx scripts/gen-mcp-tools.mts",
    "gen:social-images": "tsx scripts/gen-social-images.mts",
    "predev": "pnpm gen:mcp-tools && pnpm gen:social-images",
    "dev": "blume dev",
    "prebuild": "pnpm gen:mcp-tools && pnpm gen:social-images",
    "build": "blume validate --strict && blume build --strict",
    "preview": "blume preview",
    "typecheck": "blume check --strict"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "^5.3.0",
    "@trainheroic-unofficial/js": "workspace:*",
    "astro": "^7.2.2",
    "blume": "^1.5.1"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@trainheroic-unofficial/eval": "workspace:*",
    "tsx": "^4.23.12",
    "wrangler": "^4.123.0"
  },
  "engines": {
    "node": ">=24"
  }
}
