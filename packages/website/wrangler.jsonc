{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "trainheroic-unofficial",
  "compatibility_date": "2026-06-19",
  // Serve every uploaded version at <version>-trainheroic-unofficial.<subdomain>.workers.dev, so
  // Workers Builds posts a preview link for each branch build. Cloudflare defaults this to the
  // value of `workers_dev`; setting it here keeps it on even if the dashboard toggle changes.
  "preview_urls": true,
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash"
  },
  "routes": [
    { "pattern": "trainheroic-unofficial.com", "custom_domain": true },
    { "pattern": "www.trainheroic-unofficial.com", "custom_domain": true }
  ]
}
