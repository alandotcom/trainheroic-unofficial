{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "trainheroic-unofficial",
  "compatibility_date": "2026-06-19",
  // Serve every uploaded version at <version>-trainheroic-unofficial.<subdomain>.workers.dev, so
  // Workers Builds posts a preview link for each branch build. Cloudflare defaults this to the
  // value of `workers_dev`; setting it here keeps it on even if the dashboard toggle changes.
  "preview_urls": true,
  "assets": {
    "directory": "./dist",
    // Blume writes each page as <route>/index.html but links to it, lists it in sitemap.xml, and
    // declares it canonical without a trailing slash (/connect). This mode serves the index file
    // at that slashless URL and redirects /connect/ to it, so every sitemap URL answers 200.
    "html_handling": "drop-trailing-slash",
    // Serve Blume's built 404.html, with a 404 status, for paths that match no asset.
    "not_found_handling": "404-page"
  },
  "routes": [
    { "pattern": "trainheroic-unofficial.com", "custom_domain": true },
    { "pattern": "www.trainheroic-unofficial.com", "custom_domain": true }
  ]
}
