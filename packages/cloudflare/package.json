    "@sentry/cloudflare": "^10.70.0",
    "@trainheroic-unofficial/core": "workspace:*",
    "@trainheroic-unofficial/db": "workspace:*",
    "@trainheroic-unofficial/js": "workspace:*",
    "agents": "^0.20.1",
    "drizzle-orm": "1.0.0-rc.4",
    "hono": "^4.13.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@babel/core": "^8.0.1",
    "@cloudflare/vitest-pool-workers": "^0.21.3",
    "@cloudflare/workers-types": "^5.20260816.1",
    "@types/node": "^26.2.0",
    "drizzle-kit": "1.0.0-rc.4",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10",
    "wrangler": "^4.123.0"
