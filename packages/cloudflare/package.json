  "dependencies": {
    "@cfworker/json-schema": "^4.1.1",
    "@cloudflare/workers-oauth-provider": "1.2.3",
    "@modelcontextprotocol/server": "2.3.1",
    "@sentry/cloudflare": "^11.7.0",
    "@trainheroic-unofficial/core": "workspace:*",
    "@trainheroic-unofficial/db": "workspace:*",
    "@trainheroic-unofficial/dto": "workspace:*",
    "@trainheroic-unofficial/js": "workspace:*",
    "agents": "^0.28.1",
    "drizzle-orm": "1.0.0-rc.5-5935859",
    "hono": "^4.13.13",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@babel/core": "^8.0.7",
    "@cloudflare/vitest-plugin": "^1.4.2",
    "@cloudflare/workers-types": "^5.20261014.1",
    "@modelcontextprotocol/client": "2.3.1",
    "@types/node": "^26.6.5",
    "drizzle-kit": "1.0.0-rc.5-5935859",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4",
    "wrangler": "^4.151.0"
  }
