
{

  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "trainheroic-local": {
      "type": "local",
      "command": ["bash", "scripts/mcp-eval-server.sh", "athlete"]
    },
    "trainheroic-local-coach": {
      "type": "local",
      "command": ["bash", "scripts/mcp-eval-server.sh", "coach"]
    },
    "trainheroic-remote": {
      "type": "remote",
      "url": "http://localhost:8787/mcp"
    }
  }
}
